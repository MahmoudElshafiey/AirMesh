<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal permissions needed for Wi-Fi Direct and TCP sockets. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location: Wi-Fi Direct discovery needs it on Android 10-12, and the
         user can share their position at any time. It is requested only when
         they tap "Share my location", never at startup. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 13+: nearby Wi-Fi devices replaces location for Wi-Fi Direct. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Android 17+: Local Network Protection requires this runtime permission
         for apps targeting SDK 37; without it a client's connect to the group
         owner times out instead of being refused. On Android 14-16 protection
         is opt-in and covered by NEARBY_WIFI_DEVICES, which we also request —
         declaring it there is harmless (unknown permissions are ignored). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Foreground service: keeps the mesh running while the screen is off or
         the app is in the background, like a normal messaging app. The
         connectedDevice type matches what we do (talk to nearby Wi-Fi Direct
         devices); it also names the permission that authorizes that type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Android 13+: runtime permission for the per-message notifications. It is
         requested gracefully from MeshActivity and never blocks the service — if
         it is denied, the mesh still runs (only the extra notifications are gone).
         Ignored on older versions where notifications need no permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- Real mesh UI: launcher. The throwaway Wi-Fi Direct prototype stays
             reachable from a button inside MeshActivity.
             singleTop (not singleTask): tapping a notification while this activity
             is at the top of its task reuses it via onNewIntent instead of stacking
             a second copy; singleTask would also pop PrototypeActivity off the stack,
             which surprises users who opened it from the Network tab. -->
        <activity
            android:name=".ui.MeshActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- THROWAWAY PROTOTYPE: fallback, opened explicitly from MeshActivity. -->
        <activity
            android:name=".transport.PrototypeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true" />

        <!-- Owns the mesh (node + Wi-Fi Direct connector) so it survives the
             Activity going to the background. Started from MeshActivity after
             permissions are granted; never at boot. -->
        <service
            android:name=".service.MeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
